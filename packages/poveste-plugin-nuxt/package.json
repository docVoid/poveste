{
  "name": "@poveste/plugin-nuxt",
  "type": "module",
  "version": "0.2.0",
  "description": "Poveste plugin to integrate with Nuxt 3 and Nuxt 4",
  "author": {
    "name": "Sorin Gitlan"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/poveste-dev/poveste.git",
    "type": "git",
    "directory": "packages/poveste-plugin-nuxt"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc -d",
    "watch": "tsc -d -w --sourceMap"
  },
  "peerDependencies": {
    "@poveste/plugin-vue": "workspace:^",
    "nuxt": "^3.0.0-rc.11 || ^4.0.0",
    "poveste": "workspace:^"
  },
  "dependencies": {
    "@nuxt/kit": "^3.14.1592",
    "@rollup/plugin-replace": "^6.0.1",
    "h3": "^1.13.0",
    "ofetch": "^1.4.1",
    "unenv": "^1.10.0"
  },
  "devDependencies": {
    "@nuxt/schema": "^3.14.1592",
    "@types/node": "^22.10.1",
    "poveste": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
